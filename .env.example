# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Set this to your real domain before
# submitting the site to Google Search Console.
NEXT_PUBLIC_SITE_URL=https://seismic-sonar.vercel.app

# Optional: paste only the token from the Google Search Console
# "HTML tag" verification snippet (content="..."), not the whole tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
